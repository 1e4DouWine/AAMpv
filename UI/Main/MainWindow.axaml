<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaAppMPV.UI.Main"
        xmlns:v="using:AvaloniaAppMPV.UI.Controls"
        xmlns:conv="using:AvaloniaAppMPV.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="800"
        d:DesignHeight="550"
        x:Class="AvaloniaAppMPV.UI.Main.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}"
        Width="900"
        Height="600"
        MinWidth="640"
        MinHeight="480"
        KeyDown="OnKeyDown"
        PointerPressed="OnWindowPointerPressed"
        PointerMoved="OnWindowPointerMoved"
        Background="{DynamicResource VideoAreaBackground}">

    <Window.Resources>
        <conv:PlayPauseIconConverter x:Key="PlayPauseIconConverter"/>
        <conv:PlayPauseTextConverter x:Key="PlayPauseTextConverter"/>
        <conv:MuteTooltipConverter x:Key="MuteTooltipConverter"/>
        <conv:VolumeIconConverter x:Key="VolumeIconConverter"/>
    </Window.Resources>

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <!-- 视频展示区域，始终铺满窗口 -->
        <v:MpvVideoView x:Name="VideoView"/>

        <!-- 底部悬浮控制条：随窗口宽度伸缩，避免小窗口出现横向拥挤 -->
        <Border x:Name="ControlBarRoot"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                MaxWidth="980"
                Margin="16,0,16,20"
                CornerRadius="16"
                ClipToBounds="True"
                Opacity="1"
                IsHitTestVisible="True"
                PointerEntered="OnControlBarPointerEntered"
                PointerExited="OnControlBarPointerExited">

            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="0:0:0.25"
                                      Easing="CubicEaseInOut"/>
                </Transitions>
            </Border.Transitions>

            <!-- 半透明背景，保留视频透视感 -->
            <Border Background="{DynamicResource PlayerBarBackgroundBrush}"
                    BorderBrush="{DynamicResource PlayerBarBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,12,18,14">

                <DockPanel>
                    <!-- 当前文件标题，帮助用户在全屏时确认正在播放的内容 -->
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,0,2,6">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   Foreground="{DynamicResource ControlBarTextBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Opacity="0.9"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="双击视频区域进入全屏"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="11"
                                   Opacity="0.75"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </Grid>

                    <!-- 顶部进度条 -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding PositionText}"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   MinWidth="45"
                                   Margin="0,0,12,0"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding DurationText}"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   MinWidth="45"
                                   Margin="12,0,0,0"/>
                        <Slider x:Name="SeekSlider"
                                Minimum="0"
                                Maximum="{Binding Duration}"
                                Value="{Binding Position}"
                                IsEnabled="{Binding HasFile}"
                                VerticalAlignment="Center"
                                KeyDown="OnSeekSliderKeyDown"
                                LostFocus="OnSeekSliderLostFocus"
                                PointerCaptureLost="OnSeekSliderCaptureLost"
                                ValueChanged="OnSeekSliderValueChanged"/>
                    </DockPanel>

                    <!-- 底部按钮行 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="40">
                        <!-- 左侧：打开文件和播放控制 -->
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                            <Button Command="{Binding OpenFileCommand}"
                                    ToolTip.Tip="打开文件"
                                    MinWidth="38"
                                    MinHeight="36"
                                    Padding="10,6"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Center">
                                <PathIcon Data="M5 4C3.89543 4 3 4.89543 3 6V18C3 19.1046 3.89543 20 5 20H19C20.1046 20 21 19.1046 21 18V8C21 6.89543 20.1046 6 19 6H13L11 4H5Z"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource ControlBarTextBrush}"/>
                            </Button>
                            <Button Command="{Binding PlayPauseCommand}"
                                    IsEnabled="{Binding HasFile}"
                                    ToolTip.Tip="{Binding IsPaused, Converter={StaticResource PlayPauseTextConverter}}"
                                    MinWidth="42"
                                    MinHeight="38"
                                    Padding="12,8"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Center">
                                <PathIcon Data="{Binding IsPaused, Converter={StaticResource PlayPauseIconConverter}}"
                                          Width="18"
                                          Height="18"
                                          Foreground="{DynamicResource ControlBarTextBrush}"/>
                            </Button>
                        </StackPanel>

                        <!-- 中间：时间显示 -->
                        <StackPanel Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding TimeText}"
                                       Foreground="{DynamicResource ControlBarTextBrush}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="播放进度"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       FontSize="10"
                                       Opacity="0.75"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 右侧：信息按钮和音量控制 -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                            <Button IsEnabled="{Binding HasFile}"
                                    Click="OnShowVideoInfoClick"
                                    ToolTip.Tip="视频信息"
                                    MinWidth="34"
                                    MinHeight="36"
                                    Padding="8,6"
                                    Margin="0,0,4,0"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Center">
                                <PathIcon Data="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2ZM13 17H11V11H13V17ZM13 9H11V7H13V9Z"
                                          Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource ControlBarTextBrush}"/>
                            </Button>
                            <Button Command="{Binding MuteCommand}"
                                    ToolTip.Tip="{Binding IsMuted, Converter={StaticResource MuteTooltipConverter}}"
                                    MinWidth="34"
                                    MinHeight="36"
                                    Padding="8,6"
                                    Background="Transparent"
                                    HorizontalContentAlignment="Center">
                                <PathIcon Width="16"
                                          Height="16"
                                          Foreground="{DynamicResource ControlBarTextBrush}">
                                    <PathIcon.Data>
                                        <MultiBinding Converter="{StaticResource VolumeIconConverter}">
                                            <Binding Path="IsMuted"/>
                                            <Binding Path="Volume"/>
                                        </MultiBinding>
                                    </PathIcon.Data>
                                </PathIcon>
                            </Button>
                            <Button Click="OnSettingsClick"
                                    ToolTip.Tip="设置"
                                    MinWidth="38"
                                    MinHeight="36"
                                    Padding="10,6"
                                    Background="Transparent"
                                    Content="设置" />
                            <Button Command="{Binding ScreenshotCommand}"
                                    IsEnabled="{Binding HasFile}"
                                    ToolTip.Tip="截图 (S)"
                                    MinWidth="36"
                                    MinHeight="36"
                                    Padding="8,6"
                                    Background="Transparent"
                                    Content="截图" />
                            <Button Command="{Binding DecreaseSpeedCommand}"
                                    IsEnabled="{Binding HasFile}"
                                    ToolTip.Tip="降低速度 ([)"
                                    MinWidth="30"
                                    MinHeight="36"
                                    Padding="4,6"
                                    Background="Transparent"
                                    Content="-" />
                            <TextBlock Text="{Binding Speed, StringFormat={}{0:0.00}x}"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       VerticalAlignment="Center"
                                       MinWidth="42"
                                       TextAlignment="Center" />
                            <Button Command="{Binding IncreaseSpeedCommand}"
                                    IsEnabled="{Binding HasFile}"
                                    ToolTip.Tip="提高速度 (])"
                                    MinWidth="30"
                                    MinHeight="36"
                                    Padding="4,6"
                                    Background="Transparent"
                                    Content="+" />
                            <Slider x:Name="VolumeSlider"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="{Binding Volume}"
                                    Width="96"
                                    VerticalAlignment="Center"
                                    KeyDown="OnVolumeSliderKeyDown"
                                    LostFocus="OnVolumeSliderLostFocus"
                                    PointerCaptureLost="OnVolumeSliderCaptureLost"
                                    ValueChanged="OnVolumeSliderValueChanged"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Border>

        <!-- 顶部错误提示条 -->
        <Border Background="{DynamicResource ErrorBannerBrush}"
                Padding="16,10"
                CornerRadius="0,0,8,8"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                IsVisible="{Binding HasError}"
                BoxShadow="0 2 8 0 #40000000">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Command="{Binding DismissErrorCommand}"
                        Background="Transparent"
                        Foreground="White"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <PathIcon Data="M19 6.41L17.59 5L12 10.59L6.41 5L5 6.41L10.59 12L5 17.59L6.41 19L12 13.41L17.59 19L19 17.59L13.41 12L19 6.41Z"
                              Width="12"
                              Height="12"/>
                </Button>
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="White"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </Border>
    </Panel>

</Window>
