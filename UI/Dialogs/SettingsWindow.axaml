<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaAppMPV.UI.Dialogs.SettingsWindow"
        Title="播放器设置"
        Width="560"
        Height="520"
        MinWidth="480"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="16" Margin="28,24,28,20">
                <StackPanel Spacing="4">
                    <TextBlock Text="播放设置" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="调整播放、渲染与截图相关选项"
                               Opacity="0.65"
                               FontSize="12" />
                </StackPanel>

                <Border BorderBrush="{DynamicResource PlayerBarBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="播放与渲染" FontSize="15" FontWeight="SemiBold" />
                        <Grid ColumnDefinitions="*,220" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="16">
                            <TextBlock Grid.Row="0" Text="硬件解码" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="HardwareDecodeComboBox">
                                <ComboBoxItem Content="自动选择（推荐）" />
                                <ComboBoxItem Content="关闭硬解" />
                                <ComboBoxItem Content="D3D11VA" />
                                <ComboBoxItem Content="D3D11VA Copy" />
                                <ComboBoxItem Content="NVDEC" />
                                <ComboBoxItem Content="NVDEC Copy" />
                                <ComboBoxItem Content="Vulkan" />
                                <ComboBoxItem Content="Vulkan Copy" />
                                <ComboBoxItem Content="DXVA2" />
                                <ComboBoxItem Content="DXVA2 Copy" />
                            </ComboBox>

                            <TextBlock Grid.Row="1" Text="渲染后端" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="RenderBackendComboBox">
                                <ComboBoxItem Content="自动（当前使用 OpenGL）" />
                                <ComboBoxItem Content="OpenGL" />
                                <ComboBoxItem Content="D3D11（尚未实现）" />
                                <ComboBoxItem Content="Vulkan（尚未实现）" />
                            </ComboBox>

                            <TextBlock Grid.Row="2" Text="默认播放速度" VerticalAlignment="Center" />
                            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="DefaultSpeedComboBox">
                                <ComboBoxItem Content="0.5x" />
                                <ComboBoxItem Content="1x" />
                                <ComboBoxItem Content="1.25x" />
                                <ComboBoxItem Content="1.5x" />
                                <ComboBoxItem Content="2x" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PlayerBarBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel Spacing="12">
                        <TextBlock Text="偏好设置" FontSize="15" FontWeight="SemiBold" />
                        <CheckBox x:Name="RememberPositionCheckBox" Content="记忆每个文件的播放位置" />
                        <CheckBox x:Name="UseCustomConfigCheckBox"
                                  Content="启用自定义 mpv.conf（重启后生效）" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{DynamicResource PlayerBarBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                    <StackPanel Spacing="10">
                        <TextBlock Text="文件与截图" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="mpv.conf 路径" Opacity="0.75" FontSize="12" />
                        <TextBox x:Name="ConfigPathTextBox" IsReadOnly="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="创建/打开配置文件" Click="OnOpenConfigClick" />
                            <Button Content="打开配置目录" Click="OnOpenConfigDirectoryClick" />
                        </StackPanel>

                        <TextBlock Text="截图目录" Opacity="0.75" FontSize="12" Margin="0,4,0,0" />
                        <TextBox x:Name="ScreenshotDirectoryTextBox" />
                    </StackPanel>
                </Border>

                <TextBlock Text="修改硬解、渲染后端或 mpv.conf 后，需要重启应用才能完全生效。"
                           TextWrapping="Wrap"
                           Opacity="0.7"
                           FontSize="12" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource PlayerBarBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="取消" Click="OnCancelClick" />
                <Button Content="保存" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
